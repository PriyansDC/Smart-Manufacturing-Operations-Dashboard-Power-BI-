      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A44"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FB"
              }
            },
            "transparency": 0
          }
